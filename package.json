{
  "name": "@capbypass/sdk",
  "version": "1.0.7",
  "description": "Official TypeScript/JavaScript SDK for CapBypass CAPTCHA solving service",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "captcha",
    "recaptcha",
    "aws-waf",
    "automation",
    "solver",
    "typescript",
    "javascript"
  ],
  "author": {
    "name": "CapBypass Development",
    "email": "dev@capbypass.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapBypass-Development/capbypass-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/CapBypass-Development/capbypass-sdk-typescript/issues"
  },
  "homepage": "https://capbypass.dev/docs/sdks/typescript",
  "dependencies": {
    "axios": "^1.13.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.12.0"
  }
}
